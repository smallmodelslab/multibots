{
  "name": "openbots-mobile",
  "main": "expo-router/entry",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/ui": "58.0.25",
    "@noble/hashes": "2.4.0",
    "@wrkrsh/webhooks": "file:../packages/webhooks",
    "expo": "58.0.21",
    "expo-audio": "58.0.10",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.17",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-glass-effect": "58.0.5",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.18",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.28",
    "expo-sharing": "58.0.21",
    "expo-status-bar": "58.0.4",
    "expo-updates": "58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.15.5",
    "react-native-webrtc": "155.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eas-cli": "27.2.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sf-symbols-typescript": "2.2.0",
    "typescript": "7.0.2"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false,
    "enableVideo": false
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
