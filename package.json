{
  "name": "openbots",
  "productName": "OpenBots",
  "version": "0.0.0",
  "description": "Bots that run on your own computers, on your ChatGPT subscription or models you host",
  "author": "wrkrsh",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/bootstrap/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-update launcher && electron-vite dev",
    "build": "electron-vite build && electron-update launcher",
    "package": "bun run build && electron-builder --config electron-builder.config.mjs --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "avatar:gif": "bun scripts/avatar-gif.ts",
    "test": "bun test ./src/features/avatars"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.81",
    "@ai-sdk/provider-utils": "5.0.72",
    "@composio/core": "0.27.0",
    "@composio/vercel": "0.13.0",
    "@noble/hashes": "2.4.0",
    "ai": "7.0.159",
    "electron-updater": "6.8.11",
    "gifenc": "1.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wrkrsh/client-log": "file:./packages/client-log",
    "@wrkrsh/composer": "file:./packages/composer",
    "@wrkrsh/computer-use": "file:./packages/computer-use",
    "@wrkrsh/electron-update": "file:./packages/electron-update",
    "@wrkrsh/glow": "file:./packages/glow",
    "@wrkrsh/webhooks": "file:./packages/webhooks",
    "@wrkrsh/whiteboard": "file:./packages/whiteboard",
    "@wrkrsh/wizard": "file:./packages/wizard",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.66.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@excalidraw/excalidraw>nanoid": "3.3.20",
    "@excalidraw/mermaid-to-excalidraw>nanoid": "5.1.16",
    "lodash-es": "4.18.1"
  }
}
