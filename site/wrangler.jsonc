// openbots.ca, built by `bun run site:build` and deployed by
// `bun run site:deploy` (worker.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbots-site",
  "account_id": "c02dd35017671c5683abf687a5dd3c33",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/antenna/*"],
  },
  "routes": [
    { "pattern": "openbots.ca", "custom_domain": true },
    { "pattern": "www.openbots.ca", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
