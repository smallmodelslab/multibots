{
  "$schema": "node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "printWidth": 80,
  "semi": true,
  "singleQuote": false,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules/",
    "out/",
    "dist/",
    "bun.lock",
    "mobile/",
    "relay/",
    "site/",
    "packages/"
  ]
}
