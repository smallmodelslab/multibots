{
  "manifest_version": 3,
  "name": "OpenBots",
  "description": "Lets your OpenBots bots use tabs of their own in your Chrome.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "OpenBots" },
  "icons": { "128": "icon.png" }
}
